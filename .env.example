DJANGO_SETTINGS_MODULE=stashcast.settings

DEBUG=True

# SECURITY WARNING: choose a new value for production
SECRET_KEY="django-insecure-q)n^3l6r8d$@3l^3y11@!m(j=^2n=#=k_4(hmu&rc*si#ce5k1"

ALLOWED_HOSTS=localhost,127.0.0.1

CSRF_TRUSTED_ORIGINS=http://localhost

# Optional: Language code for UI and video subtitles (default: en-us)
# Supported: en (English), es (Spanish), pt (Portuguese), pl (Polish)
# LANGUAGE_CODE=en-us

# Optional: Test superuser for feature branch deployments
# bootstrap.sh creates this user automatically if set
# TEST_USERNAME=test
# TEST_PASSWORD=test

# STASHCAST Configuration
# Required: Directories for storing media files
# STASHCAST_AUDIO_DIR=/path/to/audio
# STASHCAST_VIDEO_DIR=/path/to/video

# SECURITY WARNING: choose a new value for production
STASHCAST_USER_TOKEN=608AF9E5-E989-4729-9C05-7FFB6EA86FE4

# Optional: Require user token for RSS feeds (default: false)
# Set to 'true' to make feeds private (feed URLs must include ?token=YOUR_TOKEN)
# REQUIRE_USER_TOKEN_FOR_FEEDS=true

# Optional: Base URL for media files (if using external CDN)
# STASHCAST_MEDIA_BASE_URL=https://cdn.example.com

# Optional: Default yt-dlp arguments
#
# WARNING: these REPLACE the built-in defaults, they do not add to them. Setting either
# one drops everything the default contained - including the video format selector that
# pins H.264 + AAC. Without that selector YouTube's "best audio" is Opus, the result is
# a WebM/Matroska file, and Apple Podcasts reports "Cannot play this episode on this
# device". Leave both commented out unless you really mean to replace the whole string.
# To add rate limiting, use STASHCAST_YTDLP_SLEEP_INTERVAL below instead.
# See docs/VIDEO_COMPATIBILITY.md
# STASHCAST_DEFAULT_YTDLP_ARGS_AUDIO=
# STASHCAST_DEFAULT_YTDLP_ARGS_VIDEO=

# Optional: random pause between yt-dlp requests, in seconds (0 = disabled).
# Reduces the chance of hitting YouTube's rate limiting. Composes with the defaults,
# unlike putting --sleep-interval in STASHCAST_DEFAULT_YTDLP_ARGS_* above.
# STASHCAST_YTDLP_SLEEP_INTERVAL=5
# STASHCAST_YTDLP_MAX_SLEEP_INTERVAL=30

# Optional: repack a downloaded video when podcast clients could not play it
# (WebM/Matroska container, AV1/VP9 video or Opus audio -> MP4/H.264/AAC).
# Default: true. Set to false to keep files exactly as downloaded.
# STASHCAST_ENSURE_PLAYABLE_VIDEO=true

# Optional: Proxy URL for yt-dlp requests
# Use residential proxy to avoid YouTube blocking cloud VM IPs
# Formats: http://host:port, socks5://host:port, socks5://user:pass@host:port
# See docs/YOUTUBE_AUTH.md for detailed setup instructions
# STASHCAST_YTDLP_PROXY=socks5://user:pass@host:port

# Optional: Default ffmpeg arguments
# STASHCAST_DEFAULT_FFMPEG_ARGS_AUDIO=
# STASHCAST_DEFAULT_FFMPEG_ARGS_VIDEO=

# Optional: Slug generation settings
# STASHCAST_SLUG_MAX_WORDS=6
# STASHCAST_SLUG_MAX_CHARS=40

# Optional: Podcast Index API for discovering original RSS feeds
# Get free API keys at: https://podcastindex.org/
# PODCAST_INDEX_API_KEY=your_api_key
# PODCAST_INDEX_API_SECRET=your_api_secret

# Optional: Auto-select first match for Spotify URLs (no user input needed)
# STASHCAST_ACCEPT_FIRST_MATCH=true

# Optional: Maximum number of episodes to keep (0 = unlimited)
# When the limit is reached, new downloads are blocked until episodes are deleted
# STASHCAST_MAX_EPISODES=50

# Optional: YouTube channel auto-sync
# Groups with a "YouTube channel URL" set are periodically checked for new uploads,
# which are auto-downloaded as audio into that group. Requires the Huey worker
# (run_huey) to be running so the periodic task fires.
# Interval in hours between checks (1..23, default 3):
# STASHCAST_YOUTUBE_SYNC_HOURS=3
# Most recent uploads to consider per check (bounds first-run back-catalogue, default 5):
# STASHCAST_YOUTUBE_SYNC_MAX_VIDEOS=5

# Optional: paced download queue
# Channel uploads are not downloaded all at once - they wait in status QUEUED and are
# released a batch at a time, so a new channel cannot flood the workers. A download
# that fails is retried automatically with a growing backoff.
# See docs/DOWNLOAD_QUEUE.md and ./manage.py download_queue
# How often the queue releases downloads, in minutes (1..59, default 5):
# STASHCAST_DOWNLOAD_QUEUE_MINUTES=5
# How many downloads to release per interval (raise it to backfill faster, default 1):
# STASHCAST_DOWNLOAD_QUEUE_BATCH=1
# Attempts before an item is marked as failed (1 disables retrying, default 3):
# STASHCAST_DOWNLOAD_MAX_ATTEMPTS=3
# Idle minutes after which an in-progress item is treated as abandoned (default 30):
# STASHCAST_STUCK_TIMEOUT_MINUTES=30
# Retry pacing per error type. A members-only / private / removed video is never
# retried at all; a premiere is retried around the time it airs; a bot check or rate
# limit gets a long rest instead of hammering YouTube.
# How long to wait for a premiere when the message carries no time (default 60 min):
# STASHCAST_DOWNLOAD_RETRY_SCHEDULED_MINUTES=60
# How long to rest after a bot check / rate limit (default 120 min):
# STASHCAST_DOWNLOAD_RETRY_BLOCKED_MINUTES=120
# Attempt budget for premieres, which wait hours between tries (default 8):
# STASHCAST_DOWNLOAD_SCHEDULED_MAX_ATTEMPTS=8
# How far a file's real duration may differ from the source's before ./manage.py
# check_durations calls it incomplete, in seconds (default 3):
# STASHCAST_DURATION_TOLERANCE_SECONDS=3

# Optional: transcripts via a Wyoming protocol server you run yourself (wyoming-whisper
# and friends). Audio never leaves your network. Podcast clients that support
# transcripts, Apple Podcasts included, pick the result up from the RSS feed.
# See docs/TRANSCRIPTS.md
# STASHCAST_WHISPER_ENABLED=true
# Address of the server - 'tcp://host:port', 'host:port', or just 'host' (port 10300):
# STASHCAST_WHISPER_URI=tcp://whisper:10300
# Language of the AUDIO, e.g. 'pl'. Empty = let the model detect it, in which case the
# language heard in the first window is reused for the whole episode.
# This is NOT the interface language: telling Whisper that Polish recordings are English
# makes it answer with an English translation. Set it whenever you know the language.
# STASHCAST_WHISPER_LANGUAGE=pl
# Audio is sent in windows of this many seconds; the boundaries become cue timings.
# Shorter windows give finer timings, longer ones give the model more context (min 5):
# STASHCAST_WHISPER_WINDOW_SECONDS=15
# Socket timeout for a single window, in seconds:
# STASHCAST_WHISPER_TIMEOUT_SECONDS=300
# Heartbeat age in seconds at which the worker is reported as down (default 180):
# STASHCAST_WORKER_HEARTBEAT_STALE_SECONDS=180

# Optional: yt-dlp fixes for "HTTP Error 403: Forbidden" and YouTube bot checks
# See docs/YOUTUBE_AUTH.md
# Path to a Netscape-format cookies.txt exported from a logged-in browser session:
# STASHCAST_YTDLP_COOKIES_FILE=/data/cookies.txt
# Or read cookies straight from a local browser profile (non-container installs):
# STASHCAST_YTDLP_COOKIES_FROM_BROWSER=firefox
# JavaScript runtime for YouTube player challenges (deno is auto-detected on PATH):
# STASHCAST_YTDLP_JS_RUNTIMES=node
# Player clients retried after a 403:
# STASHCAST_YTDLP_PLAYER_CLIENTS=default,tv,web_safari,mweb,tv_embedded
# Browser TLS fingerprint to impersonate (requires curl_cffi):
# STASHCAST_YTDLP_IMPERSONATE=chrome
