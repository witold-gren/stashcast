#: media/admin.py:104
#, python-format
msgid "Sync YouTube channel - newest %(count)s videos"
msgstr "Synchronizuj kanał YouTube – najnowsze %(count)s filmów"

#: media/admin.py:120
msgid "Pick at least one user to notify, or untick \"notify on download\"."
msgstr ""
"Wybierz co najmniej jednego użytkownika do powiadamiania albo odznacz "
"„Powiadamiaj o pobraniu”."

#: media/admin.py:166
msgid "Approval & notifications"
msgstr "Zatwierdzanie i powiadomienia"

#: media/admin.py:170 media/admin.py:203
msgid "Auto-delete"
msgstr "Automatyczne usuwanie"

#: media/admin.py:190
#, python-format
msgid ""
"\"%(group)s\" asks before downloading but notifies nobody. New uploads will "
"wait under \"Awaiting Approval\" in the admin."
msgstr ""
"Grupa „%(group)s” pyta przed pobraniem, ale nikogo nie powiadamia. Nowe "
"filmy będą czekać w panelu w sekcji „Oczekujące na zatwierdzenie”."

