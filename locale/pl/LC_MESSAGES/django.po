msgid "None of the selected groups has a YouTube channel configured."
msgstr "Żadna z zaznaczonych grup nie ma ustawionego kanału YouTube."

#: media/admin.py:280
#, python-format
msgid ""
"Checked the newest %(depth)s upload(s) of %(channels)s channel(s): queued "
"%(queued)s new item(s). They are released a few at a time by the paced "
"download queue."
msgstr ""
"Sprawdzono najnowsze filmy (%(depth)s) na kanałach (%(channels)s): dodano do "
"kolejki nowe elementy (%(queued)s). Kolejka pobierania wypuszcza je po kilka "
"naraz."

#: media/admin.py:286
#, python-format
msgid "%(count)s new item is awaiting your approval."
msgid_plural "%(count)s new items are awaiting your approval."
msgstr[0] "%(count)s nowy element czeka na Twoje zatwierdzenie."
msgstr[1] "%(count)s nowe elementy czekają na Twoje zatwierdzenie."
msgstr[2] "%(count)s nowych elementów czeka na Twoje zatwierdzenie."
msgstr[3] "%(count)s nowego elementu czeka na Twoje zatwierdzenie."

#: media/admin.py:296
#, python-format
msgid "Sync YouTube channel now (newest %(count)s only)"
msgstr "Synchronizuj kanał YouTube teraz (tylko %(count)s najnowszych)"

#: media/admin.py:324
#, python-format
msgid ""
"Scanning %(channels)s channel(s) in the background. Every upload found is "
"added to the paced queue and downloaded %(batch)s at a time every "
"%(interval)s min - watch it with \"./manage.py download_queue\"."
msgstr ""
"Skanowanie kanałów (%(channels)s) w tle. Każdy znaleziony film trafia do "
"kolejki i jest pobierany po %(batch)s co %(interval)s min – postęp "
"sprawdzisz przez „./manage.py download_queue”."

#: media/admin.py:332
msgid "Download ENTIRE channel (paced, background)"
msgstr "Pobierz CAŁY kanał (stopniowo, w tle)"

#: media/admin.py:347 media/admin.py:684
msgid ""
"Speech to text is switched off. Set STASHCAST_WHISPER_ENABLED=true and point "
"STASHCAST_WHISPER_URI at your Wyoming server."
msgstr ""
"Zamiana mowy na tekst jest wyłączona. Ustaw STASHCAST_WHISPER_ENABLED=true i "
"wskaż w STASHCAST_WHISPER_URI swój serwer Wyoming."

#: media/admin.py:361
msgid "The selected groups hold no downloaded items."
msgstr "Zaznaczone grupy nie mają pobranych elementów."

#: media/admin.py:364 media/admin.py:699
