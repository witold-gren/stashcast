msgstr "Mídias baixadas do grupo “%(group)s”"

#: media/models.py:23
msgid "Name"
msgstr "Nome"

#: media/models.py:25 media/models.py:241
msgid "Slug"
msgstr "Slug"

#: media/models.py:32
msgid "Optional cover image shown as <image> in this group's RSS feed."
msgstr "Imagem de capa opcional exibida como <image> no feed RSS deste grupo."

#: media/models.py:35
msgid "YouTube channel URL"
msgstr "URL do canal do YouTube"

#: media/models.py:39
msgid ""
"Optional YouTube channel URL (e.g. https://www.youtube.com/@name). New "
"uploads are periodically downloaded as audio into this group."
msgstr ""
"URL opcional de um canal do YouTube (ex.: https://www.youtube.com/@nome). Os "
"vídeos novos são baixados periodicamente para este grupo."

#: media/models.py:44
msgid "Last YouTube sync"
msgstr "Última sincronização do YouTube"

#: media/models.py:47
msgid "When this group was last checked for new YouTube uploads."
msgstr ""
"Quando este grupo foi verificado pela última vez em busca de vídeos novos no "
"YouTube."

#: media/models.py:57 media/models.py:215 media/models.py:226
#: media/templates/admin/bookmarklet.html:200
