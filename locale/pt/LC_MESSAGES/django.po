#: media/admin.py:104
#, python-format
msgid "Sync YouTube channel - newest %(count)s videos"
msgstr "Sincronizar canal do YouTube – os %(count)s vídeos mais recentes"

#: media/admin.py:120
msgid "Pick at least one user to notify, or untick \"notify on download\"."
msgstr ""
"Escolha pelo menos um usuário para notificar ou desmarque “Notificar ao "
"baixar”."

#: media/admin.py:166
msgid "Approval & notifications"
msgstr "Aprovação e notificações"

#: media/admin.py:170 media/admin.py:203
msgid "Auto-delete"
msgstr "Exclusão automática"

#: media/admin.py:190
#, python-format
msgid ""
"\"%(group)s\" asks before downloading but notifies nobody. New uploads will "
"wait under \"Awaiting Approval\" in the admin."
msgstr ""
"“%(group)s” pergunta antes de baixar, mas não notifica ninguém. Os novos "
"vídeos aguardarão em “Aguardando aprovação” no painel."

#: media/admin.py:201
#, python-format
msgid "%(count)s day"
msgid_plural "%(count)s days"
msgstr[0] "%(count)s dia"
msgstr[1] "%(count)s dias"

#: media/admin.py:214
msgid "None of the selected groups has auto-delete switched on."
msgstr "Nenhum dos grupos selecionados tem a exclusão automática ativada."

#: media/admin.py:222
#, python-format
msgid "Deleted %(count)s item past its group's retention period."
msgid_plural "Deleted %(count)s items past their group's retention period."
msgstr[0] "%(count)s item excluído por passar do período de retenção do grupo."
msgstr[1] ""
"%(count)s itens excluídos por passarem do período de retenção do grupo."

#: media/admin.py:229
msgid "Auto-delete expired items now"
msgstr "Excluir agora os itens expirados"

#: media/admin.py:234 media/templates/admin/admin_stash_confirm_multiple.html:5
msgid "Items"
msgstr "Itens"

#: media/admin.py:243
msgid "never synced"
msgstr "nunca sincronizado"

#: media/admin.py:246
msgid "YouTube sync"
msgstr "Sincronização do YouTube"

#: media/admin.py:266 media/admin.py:315
msgid "None of the selected groups has a YouTube channel configured."
msgstr "Nenhum dos grupos selecionados tem um canal do YouTube configurado."

#: media/admin.py:280
#, python-format
msgid ""
"Checked the newest %(depth)s upload(s) of %(channels)s channel(s): queued "
"%(queued)s new item(s). They are released a few at a time by the paced "
"download queue."
msgstr ""
"Foram verificados os %(depth)s vídeos mais recentes de %(channels)s "
"canal(is): %(queued)s item(ns) novo(s) na fila. A fila de downloads os "
"libera aos poucos."

#: media/admin.py:286
#, python-format
msgid "%(count)s new item is awaiting your approval."
msgid_plural "%(count)s new items are awaiting your approval."
msgstr[0] "%(count)s item novo aguarda sua aprovação."
msgstr[1] "%(count)s itens novos aguardam sua aprovação."

#: media/admin.py:296
#, python-format
msgid "Sync YouTube channel now (newest %(count)s only)"
msgstr "Sincronizar canal do YouTube agora (apenas os %(count)s mais recentes)"

#: media/admin.py:324
#, python-format
msgid ""
"Scanning %(channels)s channel(s) in the background. Every upload found is "
"added to the paced queue and downloaded %(batch)s at a time every "
"%(interval)s min - watch it with \"./manage.py download_queue\"."
msgstr ""
"Verificando %(channels)s canal(is) em segundo plano. Cada vídeo encontrado "
"entra na fila e é baixado de %(batch)s em %(batch)s a cada %(interval)s min "
"– acompanhe com “./manage.py download_queue”."

#: media/admin.py:332
msgid "Download ENTIRE channel (paced, background)"
msgstr "Baixar o canal INTEIRO (aos poucos, em segundo plano)"

#: media/admin.py:347 media/admin.py:684
msgid ""
"Speech to text is switched off. Set STASHCAST_WHISPER_ENABLED=true and point "
"STASHCAST_WHISPER_URI at your Wyoming server."
msgstr ""
"A transcrição de voz está desativada. Defina STASHCAST_WHISPER_ENABLED=true "
"e aponte STASHCAST_WHISPER_URI para o seu servidor Wyoming."

#: media/admin.py:361
msgid "The selected groups hold no downloaded items."
msgstr "Os grupos selecionados não têm itens baixados."

#: media/admin.py:364 media/admin.py:699
msgid "auto-detect"
msgstr "detecção automática"

#: media/admin.py:368
#, python-format
msgid ""
"Transcribing %(count)s item(s) from %(groups)s group(s), language: "
"%(language)s. Watch the Transcript column on the item list."
msgstr ""
"Transcrevendo %(count)s item(ns) de %(groups)s grupo(s), idioma: "
"%(language)s. Acompanhe na coluna “Transcrição” da lista de itens."

#: media/admin.py:375
msgid "Create transcript for all items in group"
msgstr "Criar transcrição de todos os itens do grupo"

#: media/admin.py:388 media/models.py:28
msgid "Image"
msgstr "Imagem"

#: media/admin.py:397
msgid "No image uploaded"
msgstr "Nenhuma imagem enviada"

#: media/admin.py:399
msgid "Image preview"
msgstr "Pré-visualização da imagem"

#: media/admin.py:417 media/admin.py:648
#: media/templates/admin/admin_stash_confirm_multiple.html:199
msgid "Duration"
msgstr "Duração"

#: media/admin.py:425
#, python-format
msgid "Incomplete (off by more than %(seconds)ss)"
msgstr "Incompleto (diferença de mais de %(seconds)s s)"

#: media/admin.py:427
msgid "Complete"
msgstr "Completo"

#: media/admin.py:428
msgid "Not checked yet"
msgstr "Ainda não verificado"

#: media/admin.py:505
msgid "Identification"
msgstr "Identificação"

