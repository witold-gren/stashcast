#: media/templates/media/stash_progress.html:333
msgid "Processing"
msgstr "Processando"

#: media/admin.py:536
msgid "Metadata"
msgstr "Metadados"

#: media/admin.py:545 media/models.py:369
#: media/templates/admin/item_detail.html:335
msgid "Summary"
msgstr "Resumo"

#: media/admin.py:547 media/admin.py:844 media/models.py:310
msgid "Transcript"
msgstr "Transcrição"

#: media/admin.py:557
msgid "Logs & Preview"
msgstr "Logs e pré-visualização"

#: media/admin.py:559
msgid "Timestamps"
msgstr "Datas e horários"

#: media/admin.py:597
msgid "Waiting out the retry backoff; not released until then."
msgstr "Aguardando a próxima tentativa; não será liberado até lá."

#: media/admin.py:599
#, python-format
msgid "try %(attempt)s"
msgstr "tentativa %(attempt)s"

#: media/admin.py:608
msgid "Release order: oldest queued item first."
msgstr "Ordem de liberação: primeiro o item mais antigo da fila."

#: media/admin.py:611
msgid "Queue"
msgstr "Fila"

#: media/admin.py:625
msgid ""
"Not measured yet - run ./manage.py check_durations or the \"Check file "
"duration\" action."
msgstr ""
"Ainda não medido – execute ./manage.py check_durations ou a ação “Verificar "
"duração do arquivo”."

#: media/admin.py:635
#, python-format
msgid "Source says %(expected)ss, file plays %(actual)ss."
msgstr "A fonte indica %(expected)s s e o arquivo dura %(actual)s s."

#: media/admin.py:636
msgid "ok"
msgstr "ok"

#: media/admin.py:641
#, python-format
msgid ""
"Source says %(expected)ss but the file plays only %(actual)ss - the download "
"is incomplete, fetch it again."
msgstr ""
"A fonte indica %(expected)s s, mas o arquivo dura só %(actual)s s – o "
"download está incompleto, baixe novamente."

#: media/admin.py:645
#, python-format
msgid "short %(gap)ss"
msgstr "faltam %(gap)s s"

#: media/admin.py:663 media/admin.py:697
msgid "No downloaded items selected."
msgstr "Nenhum item baixado selecionado."

#: media/admin.py:668
#, python-format
msgid ""
"Measuring %(count)s file(s) in the background. Reload in a moment, then use "
"the \"Duration\" filter to list the incomplete ones."
msgstr ""
"Medindo %(count)s arquivo(s) em segundo plano. Recarregue em instantes e use "
"o filtro “Duração” para listar os incompletos."

#: media/admin.py:674
msgid "Check file duration against source"
msgstr "Verificar duração do arquivo em relação à fonte"

#: media/admin.py:703
#, python-format
msgid ""
"Transcribing %(count)s item(s) in the background against %(server)s, "
"language: %(language)s. Long recordings take a while - the Transcript column "
"fills in as they finish."
msgstr ""
"Transcrevendo %(count)s item(ns) em segundo plano em %(server)s, idioma: "
"%(language)s. Gravações longas demoram – a coluna “Transcrição” é preenchida "
"conforme terminam."

#: media/admin.py:714
msgid "Create transcript"
msgstr "Criar transcrição"

#: media/admin.py:726
msgid "None of the selected items was waiting to be transcribed."
msgstr "Nenhum dos itens selecionados aguardava transcrição."

#: media/admin.py:730
#, python-format
msgid "Removed %(count)s item(s) from the transcription queue."
msgstr "%(count)s item(ns) removido(s) da fila de transcrição."

#: media/admin.py:735
#, python-format
msgid ""
"%(count)s item(s) are being transcribed right now and were left to finish - "
"work already under way cannot be interrupted."
msgstr ""
"%(count)s item(ns) está(ão) sendo transcrito(s) agora e foi(ram) deixado(s) "
"terminar – o trabalho em andamento não pode ser interrompido."

#: media/admin.py:741
msgid "Remove from transcription queue"
msgstr "Remover da fila de transcrição"

#: media/admin.py:753
msgid "None of the selected items was waiting to download."
msgstr "Nenhum dos itens selecionados aguardava download."

#: media/admin.py:759
#, python-format
msgid ""
"Removed %(count)s item(s) from the download queue. They are kept as errors "
"saying why - use \"Requeue selected items\" to put them back."
msgstr ""
"%(count)s item(ns) removido(s) da fila de downloads. Ficam como erros "
"explicando o motivo – use “Recolocar na fila” para devolvê-los."

#: media/admin.py:765
msgid "Remove from download queue"
msgstr "Remover da fila de downloads"

#: media/admin.py:778 media/admin.py:802
msgid "None of the selected items was awaiting approval."
msgstr "Nenhum dos itens selecionados aguardava aprovação."

#: media/admin.py:783
#, python-format
msgid "Downloading %(count)s approved item."
msgid_plural "Downloading %(count)s approved items."
msgstr[0] "Baixando %(count)s item aprovado."
msgstr[1] "Baixando %(count)s itens aprovados."

#: media/admin.py:790
msgid "Approve: download selected items"
msgstr "Aprovar: baixar os itens selecionados"

#: media/admin.py:807
#, python-format
msgid ""
"Rejected %(count)s item(s). They are kept without files so the channel sync "
"does not offer them again."
msgstr ""
"%(count)s item(ns) rejeitado(s). Ficam sem arquivos para que a sincronização "
"do canal não os ofereça novamente."

#: media/admin.py:813
msgid "Reject selected items"
msgstr "Rejeitar os itens selecionados"

#: media/admin.py:819
msgid "Waiting for the worker"
msgstr "Aguardando o worker"

#: media/admin.py:819
msgid "waiting"
msgstr "aguardando"

#: media/admin.py:824
msgid "Being transcribed right now"
msgstr "Sendo transcrito agora"

#: media/admin.py:825
msgid "transcribing"
msgstr "transcrevendo"

#: media/admin.py:830
msgid "Unknown error"
msgstr "Erro desconhecido"

#: media/admin.py:831
msgid "failed"
msgstr "falhou"

#: media/admin.py:838
#, python-format
msgid "%(count)s character"
msgid_plural "%(count)s characters"
msgstr[0] "%(count)s caractere"
msgstr[1] "%(count)s caracteres"

#: media/admin.py:840
#, python-format
msgid "%(count)s word"
msgid_plural "%(count)s words"
msgstr[0] "%(count)s palavra"
msgstr[1] "%(count)s palavras"

#: media/admin.py:852
msgid "No transcript yet"
msgstr "Ainda sem transcrição"

#: media/admin.py:859
msgid "Transcript text"
msgstr "Texto da transcrição"

#: media/admin.py:872
msgid ""
"No publication date - feeds fall back to the download date. Use the \"Fetch "
"publication date from source\" action."
msgstr ""
"Sem data de publicação – os feeds usam a data do download. Use a ação "
"“Buscar data de publicação na fonte”."

#: media/admin.py:875
msgid "not set"
msgstr "não definido"

#: media/admin.py:884
msgid "Published"
msgstr "Publicado"

#: media/admin.py:893
msgid "File Size"
msgstr "Tamanho do arquivo"

#: media/admin.py:898 media/templates/admin/admin_stash_form.html:364
msgid "View"
msgstr "Ver"

#: media/admin.py:899 media/templates/admin/item_detail.html:240
msgid "Edit"
msgstr "Editar"

#: media/admin.py:904 media/admin.py:944
msgid "Logs"
msgstr "Logs"

#: media/admin.py:907 media/templates/admin/admin_stash_form.html:349
msgid "Actions"
msgstr "Ações"

#: media/admin.py:927 media/admin.py:931
msgid "No log file"
msgstr "Sem arquivo de log"

#: media/admin.py:942
#, python-format
msgid "Error reading log: %(error)s"
msgstr "Erro ao ler o log: %(error)s"

#: media/admin.py:958
#, python-format
msgid "Re-fetching %(count)s item."
msgid_plural "Re-fetching %(count)s items."
msgstr[0] "Baixando novamente %(count)s item."
msgstr[1] "Baixando novamente %(count)s itens."

#: media/admin.py:962
msgid "Re-fetch selected items (immediately)"
msgstr "Baixar novamente os itens selecionados (imediatamente)"

#: media/admin.py:990
#, python-format
msgid "Requeued %(count)s item(s) for the paced download queue."
msgstr "%(count)s item(ns) recolocado(s) na fila de downloads."

#: media/admin.py:992
#, python-format
msgid "Skipped %(count)s item(s) that are downloading right now."
msgstr "%(count)s item(ns) ignorado(s) por estar sendo baixado(s) agora."

#: media/admin.py:997
msgid "Requeue selected items (paced queue)"
msgstr "Recolocar os itens selecionados na fila (gradual)"

#: media/admin.py:1017
#, python-format
msgid ""
"Fetching publication dates for %(count)s item(s) in the background. Reload "
"in a moment to see them."
msgstr ""
"Buscando datas de publicação de %(count)s item(ns) em segundo plano. "
"Recarregue em instantes para vê-las."

#: media/admin.py:1023
msgid "Fetch publication date from source"
msgstr "Buscar data de publicação na fonte"

#: media/admin.py:1041
msgid "No video items selected."
msgstr "Nenhum vídeo selecionado."

#: media/admin.py:1046
#, python-format
msgid ""
"Checking %(count)s video(s) in the background; anything that cannot play on "
"Apple Podcasts is repacked as MP4/H.264/AAC."
msgstr ""
"Verificando %(count)s vídeo(s) em segundo plano; o que não tocar no Apple "
"Podcasts é reempacotado como MP4/H.264/AAC."

#: media/admin.py:1052
msgid "Repair video for Apple Podcasts / iOS"
msgstr "Reparar vídeo para Apple Podcasts / iOS"

#: media/admin.py:1065
#, python-format
msgid "Enqueued summary generation for %(count)s item."
msgid_plural "Enqueued summary generation for %(count)s items."
msgstr[0] "Geração de resumo enfileirada para %(count)s item."
msgstr[1] "Geração de resumos enfileirada para %(count)s itens."

#: media/admin.py:1072
msgid "Regenerate summaries"
msgstr "Gerar resumos novamente"

#: media/admin.py:1082
#, python-format
msgid "Archived %(count)s item."
msgid_plural "Archived %(count)s items."
msgstr[0] "%(count)s item arquivado."
msgstr[1] "%(count)s itens arquivados."

#: media/admin.py:1086
msgid "Archive selected items"
msgstr "Arquivar os itens selecionados"

#: media/admin.py:1096
#, python-format
msgid "Unarchived %(count)s item."
msgid_plural "Unarchived %(count)s items."
msgstr[0] "%(count)s item desarquivado."
msgstr[1] "%(count)s itens desarquivados."

#: media/admin.py:1100
msgid "Unarchive selected items"
msgstr "Desarquivar os itens selecionados"

#: media/feeds.py:320
msgid "StashCast Audio"
msgstr "StashCast Áudio"

#: media/feeds.py:325
