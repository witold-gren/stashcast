#: media/models.py:35
msgid "YouTube channel URL"
msgstr "URL del canal de YouTube"

#: media/models.py:39
msgid ""
"Optional YouTube channel URL (e.g. https://www.youtube.com/@name). New "
"uploads are periodically downloaded as audio into this group."
msgstr ""
"URL opcional de un canal de YouTube (p. ej. https://www.youtube.com/"
"@nombre). Los vídeos nuevos se descargan periódicamente en este grupo."

#: media/models.py:44
msgid "Last YouTube sync"
msgstr "Última sincronización de YouTube"

#: media/models.py:47
msgid "When this group was last checked for new YouTube uploads."
msgstr ""
"Cuándo se comprobó por última vez si este grupo tenía vídeos nuevos en "
"YouTube."

#: media/models.py:57 media/models.py:215 media/models.py:226
