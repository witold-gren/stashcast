msgstr ""
"Comprobando %(count)s vídeo(s) en segundo plano; lo que no se pueda "
"reproducir en Apple Podcasts se reempaqueta como MP4/H.264/AAC."

#: media/admin.py:1052
msgid "Repair video for Apple Podcasts / iOS"
msgstr "Reparar vídeo para Apple Podcasts / iOS"

#: media/admin.py:1065
