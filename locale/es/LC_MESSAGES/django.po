#: media/admin.py:104
#, python-format
msgid "Sync YouTube channel - newest %(count)s videos"
msgstr "Sincronizar canal de YouTube – los %(count)s vídeos más recientes"

#: media/admin.py:120
msgid "Pick at least one user to notify, or untick \"notify on download\"."
msgstr ""
"Elige al menos un usuario a notificar o desmarca «Notificar al descargar»."

#: media/admin.py:166
msgid "Approval & notifications"
msgstr "Aprobación y notificaciones"

#: media/admin.py:170 media/admin.py:203
msgid "Auto-delete"
msgstr "Borrado automático"

#: media/admin.py:190
#, python-format
msgid ""
"\"%(group)s\" asks before downloading but notifies nobody. New uploads will "
"wait under \"Awaiting Approval\" in the admin."
msgstr ""
"«%(group)s» pregunta antes de descargar pero no notifica a nadie. Los nuevos "
"vídeos esperarán en «Pendientes de aprobación» del panel."

#: media/admin.py:201
#, python-format
