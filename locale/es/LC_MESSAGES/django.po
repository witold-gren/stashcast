msgid_plural "%(count)s days"
msgstr[0] "%(count)s día"
msgstr[1] "%(count)s días"
msgstr[2] "%(count)s días"

#: media/admin.py:214
msgid "None of the selected groups has auto-delete switched on."
msgstr ""
"Ninguno de los grupos seleccionados tiene activado el borrado automático."

#: media/admin.py:222
#, python-format
msgid "Deleted %(count)s item past its group's retention period."
msgid_plural "Deleted %(count)s items past their group's retention period."
msgstr[0] ""
"Se borró %(count)s elemento que superaba el periodo de conservación de su "
"grupo."
msgstr[1] ""
"Se borraron %(count)s elementos que superaban el periodo de conservación de "
"su grupo."
msgstr[2] ""
"Se borraron %(count)s elementos que superaban el periodo de conservación de "
"su grupo."

#: media/admin.py:229
msgid "Auto-delete expired items now"
msgstr "Borrar ahora los elementos caducados"

#: media/admin.py:234 media/templates/admin/admin_stash_confirm_multiple.html:5
msgid "Items"
msgstr "Elementos"

#: media/admin.py:243
msgid "never synced"
msgstr "nunca sincronizado"

#: media/admin.py:246
msgid "YouTube sync"
msgstr "Sincronización de YouTube"

#: media/admin.py:266 media/admin.py:315
msgid "None of the selected groups has a YouTube channel configured."
msgstr ""
"Ninguno de los grupos seleccionados tiene un canal de YouTube configurado."

#: media/admin.py:280
#, python-format
msgid ""
"Checked the newest %(depth)s upload(s) of %(channels)s channel(s): queued "
"%(queued)s new item(s). They are released a few at a time by the paced "
"download queue."
msgstr ""
"Se revisaron los %(depth)s vídeos más recientes de %(channels)s canal(es): "
"%(queued)s elemento(s) nuevo(s) en cola. La cola de descargas los libera de "
"pocos en pocos."

#: media/admin.py:286
#, python-format
msgid "%(count)s new item is awaiting your approval."
msgid_plural "%(count)s new items are awaiting your approval."
msgstr[0] "%(count)s elemento nuevo está pendiente de tu aprobación."
msgstr[1] "%(count)s elementos nuevos están pendientes de tu aprobación."
msgstr[2] "%(count)s elementos nuevos están pendientes de tu aprobación."

#: media/admin.py:296
#, python-format
msgid "Sync YouTube channel now (newest %(count)s only)"
msgstr "Sincronizar canal de YouTube ahora (solo los %(count)s más recientes)"

#: media/admin.py:324
#, python-format
msgid ""
"Scanning %(channels)s channel(s) in the background. Every upload found is "
"added to the paced queue and downloaded %(batch)s at a time every "
"%(interval)s min - watch it with \"./manage.py download_queue\"."
msgstr ""
"Escaneando %(channels)s canal(es) en segundo plano. Cada vídeo encontrado se "
"añade a la cola y se descarga de %(batch)s en %(batch)s cada %(interval)s "
"min; síguelo con «./manage.py download_queue»."

#: media/admin.py:332
msgid "Download ENTIRE channel (paced, background)"
msgstr "Descargar el canal COMPLETO (gradualmente, en segundo plano)"

#: media/admin.py:347 media/admin.py:684
msgid ""
"Speech to text is switched off. Set STASHCAST_WHISPER_ENABLED=true and point "
"STASHCAST_WHISPER_URI at your Wyoming server."
msgstr ""
"La transcripción de voz está desactivada. Define "
"STASHCAST_WHISPER_ENABLED=true y apunta STASHCAST_WHISPER_URI a tu servidor "
"Wyoming."

#: media/admin.py:361
msgid "The selected groups hold no downloaded items."
msgstr "Los grupos seleccionados no tienen elementos descargados."

#: media/admin.py:364 media/admin.py:699
msgid "auto-detect"
msgstr "detección automática"

#: media/admin.py:368
#, python-format
msgid ""
"Transcribing %(count)s item(s) from %(groups)s group(s), language: "
"%(language)s. Watch the Transcript column on the item list."
msgstr ""
"Transcribiendo %(count)s elemento(s) de %(groups)s grupo(s), idioma: "
"%(language)s. Sigue el progreso en la columna «Transcripción» de la lista."

#: media/admin.py:375
msgid "Create transcript for all items in group"
msgstr "Crear transcripción de todos los elementos del grupo"

