msgstr[1] "Descargando %(count)s elementos aprobados."
msgstr[2] "Descargando %(count)s elementos aprobados."

#: media/admin.py:790
msgid "Approve: download selected items"
msgstr "Aprobar: descargar los elementos seleccionados"

#: media/admin.py:807
#, python-format
msgid ""
"Rejected %(count)s item(s). They are kept without files so the channel sync "
"does not offer them again."
msgstr ""
"Se rechazaron %(count)s elemento(s). Se conservan sin archivos para que la "
"sincronización no los vuelva a ofrecer."

#: media/admin.py:813
msgid "Reject selected items"
msgstr "Rechazar los elementos seleccionados"

#: media/admin.py:819
