msgid "Queue"
msgstr "Cola"

#: media/admin.py:625
msgid ""
"Not measured yet - run ./manage.py check_durations or the \"Check file "
"duration\" action."
msgstr ""
"Aún no medido: ejecuta ./manage.py check_durations o la acción «Comprobar "
"duración del archivo»."

#: media/admin.py:635
#, python-format
msgid "Source says %(expected)ss, file plays %(actual)ss."
msgstr "La fuente indica %(expected)s s y el archivo dura %(actual)s s."

#: media/admin.py:636
msgid "ok"
msgstr "ok"

#: media/admin.py:641
#, python-format
msgid ""
"Source says %(expected)ss but the file plays only %(actual)ss - the download "
"is incomplete, fetch it again."
msgstr ""
"La fuente indica %(expected)s s pero el archivo solo dura %(actual)s s: la "
"descarga está incompleta, vuelve a descargarla."

#: media/admin.py:645
#, python-format
msgid "short %(gap)ss"
msgstr "faltan %(gap)s s"

#: media/admin.py:663 media/admin.py:697
msgid "No downloaded items selected."
msgstr "No se ha seleccionado ningún elemento descargado."

#: media/admin.py:668
#, python-format
msgid ""
"Measuring %(count)s file(s) in the background. Reload in a moment, then use "
"the \"Duration\" filter to list the incomplete ones."
msgstr ""
"Midiendo %(count)s archivo(s) en segundo plano. Recarga en un momento y usa "
"el filtro «Duración» para ver los incompletos."

#: media/admin.py:674
msgid "Check file duration against source"
msgstr "Comprobar duración del archivo frente a la fuente"

#: media/admin.py:703
#, python-format
msgid ""
"Transcribing %(count)s item(s) in the background against %(server)s, "
"language: %(language)s. Long recordings take a while - the Transcript column "
"fills in as they finish."
msgstr ""
"Transcribiendo %(count)s elemento(s) en segundo plano con %(server)s, "
"idioma: %(language)s. Las grabaciones largas tardan; la columna "
"«Transcripción» se completa a medida que terminan."

#: media/admin.py:714
msgid "Create transcript"
msgstr "Crear transcripción"

#: media/admin.py:726
msgid "None of the selected items was waiting to be transcribed."
msgstr "Ninguno de los elementos seleccionados esperaba transcripción."

#: media/admin.py:730
#, python-format
msgid "Removed %(count)s item(s) from the transcription queue."
msgstr "Se quitaron %(count)s elemento(s) de la cola de transcripción."

#: media/admin.py:735
#, python-format
msgid ""
"%(count)s item(s) are being transcribed right now and were left to finish - "
"work already under way cannot be interrupted."
msgstr ""
"%(count)s elemento(s) se están transcribiendo ahora y se dejaron terminar: "
"el trabajo en curso no se puede interrumpir."

#: media/admin.py:741
msgid "Remove from transcription queue"
msgstr "Quitar de la cola de transcripción"

#: media/admin.py:753
msgid "None of the selected items was waiting to download."
msgstr "Ninguno de los elementos seleccionados esperaba descarga."

#: media/admin.py:759
#, python-format
msgid ""
"Removed %(count)s item(s) from the download queue. They are kept as errors "
"saying why - use \"Requeue selected items\" to put them back."
msgstr ""
"Se quitaron %(count)s elemento(s) de la cola de descargas. Se conservan como "
"errores con el motivo; usa «Volver a encolar» para recuperarlos."

#: media/admin.py:765
msgid "Remove from download queue"
msgstr "Quitar de la cola de descargas"

#: media/admin.py:778 media/admin.py:802
msgid "None of the selected items was awaiting approval."
msgstr "Ninguno de los elementos seleccionados estaba pendiente de aprobación."

#: media/admin.py:783
