msgid "Waiting out the retry backoff; not released until then."
msgstr "Esperando al siguiente reintento; no se libera hasta entonces."

#: media/admin.py:599
#, python-format
msgid "try %(attempt)s"
msgstr "intento %(attempt)s"

#: media/admin.py:608
msgid "Release order: oldest queued item first."
msgstr "Orden de salida: primero el elemento más antiguo de la cola."

